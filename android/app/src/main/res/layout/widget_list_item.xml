<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/widget_item_background" android:orientation="vertical"
    android:padding="10dp" android:minHeight="60dp">
    <TextView android:id="@+id/widget_item_primary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_item_secondary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2"
        android:ellipsize="end" android:textColor="@color/widget_text_primary" android:textSize="15sp" />
    <TextView android:id="@+id/widget_item_meta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="3"
        android:ellipsize="end" android:textColor="@color/widget_text_secondary" android:textSize="12sp" />
</LinearLayout>
