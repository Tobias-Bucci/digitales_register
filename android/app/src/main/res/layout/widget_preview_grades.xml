<?xml version="1.0" encoding="utf-8"?>
<!-- Static widget picker preview; the real rows come from WidgetCollectionRemoteViewsService. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:foreground="@drawable/widget_outline"
    android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/widget_grades_title" android:textSize="21sp" android:textStyle="bold"
                    android:maxLines="2" android:ellipsize="end" android:textColor="@color/widget_text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end"
                    android:text="@string/widget_grades_subtitle" android:textSize="12sp"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:orientation="vertical" android:gravity="end">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/widget_preview_grade_average" android:textSize="27sp"
                    android:textStyle="bold" android:textColor="@color/widget_grade_good" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp"
                        android:layout_marginEnd="4dp" android:src="@drawable/ic_widget_grades"
                        android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/widget_average_label" android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="12dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/widget_item_background" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="10dp" android:minHeight="48dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:text="@string/widget_preview_subject_math"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/widget_preview_grade_1"
                    android:textColor="@color/widget_grade_good" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:background="@drawable/widget_item_background" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="10dp" android:minHeight="48dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:text="@string/widget_preview_subject_german"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/widget_preview_grade_2"
                    android:textColor="@color/widget_grade_good" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:background="@drawable/widget_item_background" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="10dp" android:minHeight="48dp">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:text="@string/widget_preview_subject_english"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/widget_preview_grade_3"
                    android:textColor="@color/widget_grade_satisfactory" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
