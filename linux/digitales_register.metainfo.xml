    <release version="1.17.1" date="2026-10-03">
      <description>
        <p>Linux-Pakete für x86_64 und aarch64 mit aktuellem App-Logo und Desktop-Integration.</p>
      </description>
    </release>
    <release version="1.8.4" date="2026-04-23">
      <description>
        <p>Updated the demo account with complete local test data and improved translations.</p>
      </description>
    </release>
  </releases>
