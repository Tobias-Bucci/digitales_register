# ============================================================
# Digitales Register - Git Ignore
# Flutter / Dart / Android / iOS / macOS / Windows / Linux
# Firebase / CI / Signing / Local Development
# ============================================================

# General temporary and system files
*.class
*.log
*.pyc
*.swp
*.tmp
*.temp
*.bak
*.orig
*.rej
*~
.DS_Store
Thumbs.db
Desktop.ini
.atom/
.buildlog/
.history/
.svn/

# IDEs and editors
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Eclipse / Buildship settings in local packages
packages/uni_links/**/**/.settings/

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
**/.gradle/
**/.kotlin/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/build/

# Web
lib/generated_plugin_registrant.dart

# Debug symbols and obfuscation
app.*.symbols
app.*.map.json

# Exceptions
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages

# Generated Dart files
**.g.dart

# Temporary tests and reports
**/test/linux
/test/**/failures/
/flutter_*.log
/AUDIT_REPORT/

# Private requests and answers
**/lib/requests/

# Vendored plugin examples
packages/firebase_analytics/example/
packages/package_info_plus/example/
packages/flutterfire/**/example/

# ============================================================
# Credentials and secrets
# ============================================================

# Environment variables
.env
.env.*
!.env.example
!.env.template

# Local credentials
**/credentials.json
**/service-account*.json
**/*-firebase-adminsdk-*.json
**/secrets.json
**/secret.json
**/client_secret*.json

# Private signing keys and certificates
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.pvk
*.pem
*.key
*.cer
*.mobileprovision
*.provisionprofile
*.p8.bak
*.p12.bak

# Android signing
android/key.properties
android/*.jks
**/key.properties
**/local.properties

# Microsoft Store signing
tool/microsoft_store.local.psd1
*.msix
*.msixbundle

# ============================================================
# Firebase
# ============================================================

# Native Firebase configuration
# Must be provided separately during CI builds.
**/google-services.json
**/GoogleService-Info.plist

# Generated FlutterFire configuration
# Must be provided or regenerated during CI builds.
/lib/firebase_options.dart

# Firebase local emulator data
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
ui-debug.log
.firebase/
firebase-export/
firebase-emulator-data/

# Firebase Admin SDK credentials are covered above.
# firebase.json is intentionally NOT ignored.

# ============================================================
# iOS / macOS
# ============================================================

# Generated Flutter files
ios/Flutter/ephemeral/
macos/Flutter/GeneratedPluginRegistrant.swift

**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh

# CocoaPods and generated symlinks
**/ios/Pods/
**/ios/.symlinks/
**/macos/Pods/
**/macos/.symlinks/

# Xcode user-specific files
*.mode1v3
*.mode2v3
*.pbxuser
*.perspectivev3
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcscmblueprint
*.xccheckout

# Xcode build artifacts
*.xcarchive
*.ipa
*.dSYM/
DerivedData/

# Local Xcode project backups
*.pbxproj.bak

# ============================================================
# Flatpak
# ============================================================

.flatpak-builder/
build-dir/
repo/
# Local Flutter export environment (contains local paths)
packages/charts_repo/charts_flutter/example/ios/Flutter/flutter_export_environment.sh
